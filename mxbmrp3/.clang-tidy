# The checks tests/integration/check_clang_tidy.sh enforces (its header says
# why each one is here). Every enabled check is an error: a check worth running
# is worth failing on, and a warning nobody reads is how a gate goes green while
# the bug ships. Add a check to BOTH lists.
Checks: '-*,bugprone-use-after-move'
WarningsAsErrors: 'bugprone-use-after-move'
# Project headers only; vendor/ is not ours to fix. Matched on the header's OWN
# folder (the last one in its path), not on any folder along it: a header is
# reported by the path it was included through, so core/../vendor/nlohmann/
# json.hpp contains "mxbmrp3/core/" and a looser pattern lets vendor in. That
# stayed hidden until clang-tidy 23 started flagging json.hpp's move ctor.
# (ExcludeHeaderFilterRegex would say it directly, but clang-tidy 18 rejects it.)
HeaderFilterRegex: 'mxbmrp3/(.*/)?(core|hud|settings|handlers|game|adapters|diagnostics)/[^/]*$'
