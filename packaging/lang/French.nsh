; packaging/lang/French.nsh - see English.nsh for what these are and the rules.

LangString MXB_WELCOME ${LANG_FRENCH} "Cet assistant va installer ${PLUGIN_NAME} pour les jeux de course PiBoSo.$\n$\n${PLUGIN_NAME} est gratuit et open source.$\n$\nJeux pris en charge :$\n  • MX Bikes$\n  • GP Bikes$\n  • Kart Racing Pro$\n$\nL'installation va chercher vos jeux automatiquement.$\n$\nCliquez sur Suivant pour continuer."
LangString MXB_FINISH ${LANG_FRENCH} "${PLUGIN_NAME} a été installé sur votre ordinateur.$\n$\nVos réglages et données sont stockés par jeu dans :$\n  Documents\PiBoSo\[Jeu]\${PLUGIN_NAME_LC}\$\n$\nCliquez sur Fermer pour quitter l'installation."
LangString MXB_UN_FINISH ${LANG_FRENCH} "${PLUGIN_NAME} a été désinstallé de votre ordinateur.$\n$\nPour supprimer tous les réglages et données, supprimez à la main :$\n  Documents\PiBoSo\[Jeu]\${PLUGIN_NAME_LC}\$\n$\nCliquez sur Fermer pour quitter."
LangString MXB_UN_FINISH_WIPED ${LANG_FRENCH} "${PLUGIN_NAME} a été désinstallé de votre ordinateur.$\n$\nLes réglages et données des jeux désinstallés ont aussi été supprimés.$\n$\nCliquez sur Fermer pour quitter."
LangString MXB_EXIST_TITLE ${LANG_FRENCH} "Installation de ${PLUGIN_NAME} existante détectée"
LangString MXB_EXIST_SUB ${LANG_FRENCH} "Une version existante a été trouvée. Choisissez comment continuer."
LangString MXB_EXIST_FOUND ${LANG_FRENCH} "Installation de ${PLUGIN_NAME} trouvée pour : $R1"
LangString MXB_EXIST_CHOOSE ${LANG_FRENCH} "Choisissez une action."
LangString MXB_EXIST_ACTION ${LANG_FRENCH} "Action"
LangString MXB_EXIST_UPGRADE ${LANG_FRENCH} "Mettre à jour — remplacer les fichiers, garder réglages et données"
LangString MXB_EXIST_FRESH ${LANG_FRENCH} "Réinstaller — remplacer les fichiers, effacer réglages et données"
LangString MXB_EXIST_REMOVE ${LANG_FRENCH} "Supprimer (désinstaller) ${PLUGIN_NAME}"
LangString MXB_NOTE_KEEP ${LANG_FRENCH} "Vos réglages et données (Documents\PiBoSo\[Jeu]\${PLUGIN_NAME_LC}) seront conservés."
LangString MXB_NOTE_WIPE ${LANG_FRENCH} "Attention : les réglages et données existants (Documents\PiBoSo\[Jeu]\${PLUGIN_NAME_LC}) seront supprimés pour chaque jeu choisi."
LangString MXB_NOTE_UNINSTALL ${LANG_FRENCH} "Le programme de désinstallation vous laissera choisir de supprimer aussi réglages et données."
LangString MXB_UNKNOWN ${LANG_FRENCH} "Inconnu"
LangString MXB_PRIV_TITLE ${LANG_FRENCH} "Confidentialité"
LangString MXB_PRIV_SUB ${LANG_FRENCH} "Choisissez de participer ou non à l'enquête d'utilisation anonyme."
LangString MXB_PRIV_BODY ${LANG_FRENCH} "${PLUGIN_NAME} peut envoyer un petit ping anonyme à chaque lancement, pour que le développeur voie combien l'utilisent, quelles fonctions garder et quoi corriger.$\n$\nIl envoie un ID d'installation aléatoire, la version et le jeu, vos fonctions activées, vos succès débloqués, système et langue, la durée de session et où le jeu a planté en cas de crash."
LangString MXB_PRIV_NEVER ${LANG_FRENCH} "Jamais envoyés : votre nom, vos temps au tour, votre activité en ligne, les données serveur ou pilotes, les dumps de crash. Votre contenu n'est jamais nommé, au plus $\"perso$\"."
LangString MXB_PRIV_CHECK ${LANG_FRENCH} "Participer à l'enquête d'utilisation anonyme"
LangString MXB_PRIV_FOOT ${LANG_FRENCH} "La désactiver ne désactive rien d'autre ; le plugin fonctionne pareil. Modifiable à tout moment dans Réglages > Général > Intégrations."
LangString MXB_PRIV_POLICY ${LANG_FRENCH} "Confidentialité"
LangString MXB_PRIV_REPORT ${LANG_FRENCH} "Voir le rapport d'utilisation publié"
LangString MXB_GAMES_TITLE ${LANG_FRENCH} "Choisir les jeux"
LangString MXB_GAMES_SUB ${LANG_FRENCH} "Choisissez pour quels jeux installer ${PLUGIN_NAME}."
LangString MXB_DETECTED ${LANG_FRENCH} "(détecté)"
LangString MXB_NOT_DETECTED ${LANG_FRENCH} "(non détecté)"
LangString MXB_SELECT_ONE ${LANG_FRENCH} "Choisissez au moins un jeu à installer."
LangString MXB_SELECT_FOLDER ${LANG_FRENCH} "Choisir le dossier d'installation de $gameLabel"
LangString MXB_SPECIFY_FOLDER ${LANG_FRENCH} "Indiquez le dossier plugins de $gameLabel."
LangString MXB_NOT_PLUGINS_FOLDER ${LANG_FRENCH} "Ceci ne semble pas être le dossier plugins de $gameLabel. Continuer quand même ?"
LangString MXB_FRESH_CONFIRM ${LANG_FRENCH} "La réinstallation va supprimer définitivement tous les réglages et données de ${PLUGIN_NAME} (profils, stats, benchmarks, journaux, dumps de crash) des jeux choisis avant de réinstaller.$\n$\nC'est irréversible. Continuer ?"
LangString MXB_ADMIN_INSTALL ${LANG_FRENCH} "Des droits administrateur sont nécessaires pour installer dans le dossier choisi.$\n$\nChoisissez un dossier où vous pouvez écrire, ou fermez l'installation et relancez-la en administrateur."
LangString MXB_DP_INSTALLING ${LANG_FRENCH} "Installation de ${PLUGIN_NAME} pour $gameLabel..."
LangString MXB_DP_GAME_DONE ${LANG_FRENCH} "Installation pour $gameLabel terminée."
LangString MXB_DP_FRESH ${LANG_FRENCH} "Réinstallation demandée - suppression des réglages et données existants..."
LangString MXB_DP_REMOVING_DATA ${LANG_FRENCH} "Suppression des réglages et données :"
LangString MXB_DP_INSTALL_DONE ${LANG_FRENCH} "Installation terminée."
LangString MXB_UN_TITLE ${LANG_FRENCH} "Choisir ce qu'il faut supprimer"
LangString MXB_UN_SUB ${LANG_FRENCH} "Choisissez quelles installations de jeux supprimer."
LangString MXB_CHANGE_SUB ${LANG_FRENCH} "Décocher un jeu en supprime le plugin."
LangString MXB_CHANGE_SELECT_ONE ${LANG_FRENCH} "Pour supprimer ${PLUGIN_NAME} de tous les jeux, choisissez Supprimer à la page précédente."
LangString MXB_UN_DATA_CHECK ${LANG_FRENCH} "Supprimer aussi réglages et données (Documents\PiBoSo\[Jeu]\${PLUGIN_NAME_LC})"
LangString MXB_UN_SELECT_ONE ${LANG_FRENCH} "Choisissez au moins un jeu à désinstaller."
LangString MXB_UN_SELECT_ONE_MSG ${LANG_FRENCH} "Choisissez au moins un jeu à désinstaller."
LangString MXB_UN_DATA_CONFIRM ${LANG_FRENCH} "Cela va supprimer définitivement tous les réglages et données de ${PLUGIN_NAME} (profils, stats, benchmarks, journaux, dumps de crash) des jeux choisis.$\n$\nC'est irréversible. Continuer ?"
LangString MXB_UN_ADMIN ${LANG_FRENCH} "Des droits administrateur sont nécessaires pour supprimer ${PLUGIN_NAME} du dossier choisi.$\n$\nFermez ceci et relancez la désinstallation en administrateur, ou annulez."
LangString MXB_DP_UN_FILES ${LANG_FRENCH} "Suppression des fichiers de ${PLUGIN_NAME}..."
LangString MXB_DP_UN_FROM ${LANG_FRENCH} "Suppression de $gameLabel..."
LangString MXB_DP_UN_DATA ${LANG_FRENCH} "Suppression des réglages et données de ${PLUGIN_NAME}..."
LangString MXB_DP_UN_DONE ${LANG_FRENCH} "Désinstallation terminée."
LangString MXB_DP_ALL_REMOVED ${LANG_FRENCH} "Toutes les installations ont été supprimées."
LangString MXB_DP_PARTIAL ${LANG_FRENCH} "Désinstallation partielle terminée. Certaines installations restent."
LangString MXB_PLUGIN_LANG ${LANG_FRENCH} "fr"
