; packaging/lang/German.nsh - see English.nsh for what these are and the rules.

LangString MXB_WELCOME ${LANG_GERMAN} "Dieser Assistent installiert ${PLUGIN_NAME} für PiBoSo-Rennspiele.$\n$\n${PLUGIN_NAME} ist kostenlos und quelloffen.$\n$\nUnterstützte Spiele:$\n  • MX Bikes$\n  • GP Bikes$\n  • Kart Racing Pro$\n$\nSetup versucht, deine Spielinstallationen automatisch zu finden.$\n$\nKlicke auf Weiter, um fortzufahren."
LangString MXB_FINISH ${LANG_GERMAN} "${PLUGIN_NAME} wurde auf deinem Computer installiert.$\n$\nDeine Einstellungen und Daten liegen pro Spiel in:$\n  Documents\PiBoSo\[Spiel]\${PLUGIN_NAME_LC}\$\n$\nKlicke auf Fertigstellen, um Setup zu schließen."
LangString MXB_UN_FINISH ${LANG_GERMAN} "${PLUGIN_NAME} wurde von deinem Computer entfernt.$\n$\nUm alle Einstellungen und Daten zu entfernen, lösche von Hand:$\n  Documents\PiBoSo\[Spiel]\${PLUGIN_NAME_LC}\$\n$\nKlicke auf Fertigstellen, um Setup zu schließen."
LangString MXB_UN_FINISH_WIPED ${LANG_GERMAN} "${PLUGIN_NAME} wurde von deinem Computer entfernt.$\n$\nEinstellungen und Daten der deinstallierten Spiele wurden ebenfalls gelöscht.$\n$\nKlicke auf Fertigstellen, um Setup zu schließen."
LangString MXB_EXIST_TITLE ${LANG_GERMAN} "Vorhandene ${PLUGIN_NAME}-Installation gefunden"
LangString MXB_EXIST_SUB ${LANG_GERMAN} "Eine vorhandene Version wurde gefunden. Wähle, wie es weitergeht."
LangString MXB_EXIST_FOUND ${LANG_GERMAN} "Vorhandene ${PLUGIN_NAME}-Installation gefunden für: $R1"
LangString MXB_EXIST_CHOOSE ${LANG_GERMAN} "Wähle eine Aktion."
LangString MXB_EXIST_ACTION ${LANG_GERMAN} "Aktion"
LangString MXB_EXIST_UPGRADE ${LANG_GERMAN} "Aktualisieren — Dateien ersetzen, Einstellungen und Daten behalten"
LangString MXB_EXIST_FRESH ${LANG_GERMAN} "Neu installieren — Dateien ersetzen, Einstellungen und Daten löschen"
LangString MXB_EXIST_REMOVE ${LANG_GERMAN} "${PLUGIN_NAME} entfernen (deinstallieren)"
LangString MXB_NOTE_KEEP ${LANG_GERMAN} "Deine Einstellungen und Daten (Documents\PiBoSo\[Spiel]\${PLUGIN_NAME_LC}) bleiben erhalten."
LangString MXB_NOTE_WIPE ${LANG_GERMAN} "Achtung: Vorhandene Einstellungen und Daten (Documents\PiBoSo\[Spiel]\${PLUGIN_NAME_LC}) werden für jedes gewählte Spiel gelöscht."
LangString MXB_NOTE_UNINSTALL ${LANG_GERMAN} "Im Deinstallationsprogramm kannst du wählen, ob auch Einstellungen und Daten entfernt werden."
LangString MXB_UNKNOWN ${LANG_GERMAN} "Unbekannt"
LangString MXB_PRIV_TITLE ${LANG_GERMAN} "Datenschutz"
LangString MXB_PRIV_SUB ${LANG_GERMAN} "Wähle, ob du an der anonymen Nutzungsumfrage teilnimmst."
LangString MXB_PRIV_BODY ${LANG_GERMAN} "${PLUGIN_NAME} kann bei jedem Spielstart einen kleinen anonymen Ping senden. So sieht der Entwickler, wie viele es nutzen, was sich lohnt und was zu reparieren ist.$\n$\nGesendet werden eine zufällige Installations-ID, Plugin-Version und Spiel, aktive Funktionen, freigeschaltete Erfolge, System und Sprache, Sitzungsdauer und bei Abstürzen die Fehlerstelle."
LangString MXB_PRIV_NEVER ${LANG_GERMAN} "Nie gesendet: Name, Rundenzeiten, Online-Aktivität, Server- oder Fahrerdaten, Absturz-Dumps. Eigene Inhalte werden nie namentlich gemeldet, höchstens als $\"eigene$\"."
LangString MXB_PRIV_CHECK ${LANG_GERMAN} "An der anonymen Nutzungsumfrage teilnehmen"
LangString MXB_PRIV_FOOT ${LANG_GERMAN} "Ausschalten deaktiviert sonst nichts; das Plugin funktioniert genauso. Jederzeit änderbar unter Optionen > Allgemein > Integrationen."
LangString MXB_PRIV_POLICY ${LANG_GERMAN} "Datenschutz"
LangString MXB_PRIV_REPORT ${LANG_GERMAN} "Veröffentlichten Nutzungsbericht ansehen"
LangString MXB_GAMES_TITLE ${LANG_GERMAN} "Spiele wählen"
LangString MXB_GAMES_SUB ${LANG_GERMAN} "Wähle, für welche Spiele ${PLUGIN_NAME} installiert wird."
LangString MXB_DETECTED ${LANG_GERMAN} "(gefunden)"
LangString MXB_NOT_DETECTED ${LANG_GERMAN} "(nicht gefunden)"
LangString MXB_SELECT_ONE ${LANG_GERMAN} "Wähle mindestens ein Spiel zum Installieren."
LangString MXB_SELECT_FOLDER ${LANG_GERMAN} "Installationsordner von $gameLabel wählen"
LangString MXB_SPECIFY_FOLDER ${LANG_GERMAN} "Bitte gib den plugins-Ordner von $gameLabel an."
LangString MXB_NOT_PLUGINS_FOLDER ${LANG_GERMAN} "Das scheint nicht der plugins-Ordner von $gameLabel zu sein. Trotzdem fortfahren?"
LangString MXB_FRESH_CONFIRM ${LANG_GERMAN} "Eine Neuinstallation löscht vor dem Installieren dauerhaft alle ${PLUGIN_NAME}-Einstellungen und -Daten (Profile, Statistiken, Benchmarks, Logs, Absturz-Dumps) der gewählten Spiele.$\n$\nDas lässt sich nicht rückgängig machen. Fortfahren?"
LangString MXB_ADMIN_INSTALL ${LANG_GERMAN} "Für die Installation in den gewählten Ordner sind Administratorrechte nötig.$\n$\nWähle einen Ordner, in den du schreiben kannst, oder schließe Setup und starte es als Administrator neu."
LangString MXB_DP_INSTALLING ${LANG_GERMAN} "${PLUGIN_NAME} wird für $gameLabel installiert..."
LangString MXB_DP_GAME_DONE ${LANG_GERMAN} "Installation für $gameLabel abgeschlossen."
LangString MXB_DP_FRESH ${LANG_GERMAN} "Neuinstallation gewählt - vorhandene Einstellungen und Daten werden gelöscht..."
LangString MXB_DP_REMOVING_DATA ${LANG_GERMAN} "Einstellungen und Daten werden entfernt:"
LangString MXB_DP_INSTALL_DONE ${LANG_GERMAN} "Installation abgeschlossen."
LangString MXB_UN_TITLE ${LANG_GERMAN} "Zu entfernende Komponenten wählen"
LangString MXB_UN_SUB ${LANG_GERMAN} "Wähle, welche Spielinstallationen entfernt werden."
LangString MXB_CHANGE_SUB ${LANG_GERMAN} "Ohne Haken wird das Plugin aus dem Spiel entfernt."
LangString MXB_CHANGE_SELECT_ONE ${LANG_GERMAN} "Um ${PLUGIN_NAME} aus allen Spielen zu entfernen, wähle auf der vorigen Seite Entfernen."
LangString MXB_UN_DATA_CHECK ${LANG_GERMAN} "Auch Einstellungen und Daten löschen (Documents\PiBoSo\[Spiel]\${PLUGIN_NAME_LC})"
LangString MXB_UN_SELECT_ONE ${LANG_GERMAN} "Wähle mindestens ein Spiel zum Deinstallieren."
LangString MXB_UN_SELECT_ONE_MSG ${LANG_GERMAN} "Bitte wähle mindestens ein Spiel zum Deinstallieren."
LangString MXB_UN_DATA_CONFIRM ${LANG_GERMAN} "Damit werden alle ${PLUGIN_NAME}-Einstellungen und -Daten (Profile, Statistiken, Benchmarks, Logs, Absturz-Dumps) der gewählten Spiele dauerhaft gelöscht.$\n$\nDas lässt sich nicht rückgängig machen. Fortfahren?"
LangString MXB_UN_ADMIN ${LANG_GERMAN} "Zum Entfernen von ${PLUGIN_NAME} aus dem gewählten Ordner sind Administratorrechte nötig.$\n$\nSchließe dies und starte das Deinstallationsprogramm als Administrator neu, oder brich ab."
LangString MXB_DP_UN_FILES ${LANG_GERMAN} "${PLUGIN_NAME}-Dateien werden entfernt..."
LangString MXB_DP_UN_FROM ${LANG_GERMAN} "Wird aus $gameLabel entfernt..."
LangString MXB_DP_UN_DATA ${LANG_GERMAN} "${PLUGIN_NAME}-Einstellungen und -Daten werden entfernt..."
LangString MXB_DP_UN_DONE ${LANG_GERMAN} "Deinstallation abgeschlossen."
LangString MXB_DP_ALL_REMOVED ${LANG_GERMAN} "Alle Installationen entfernt."
LangString MXB_DP_PARTIAL ${LANG_GERMAN} "Teilweise deinstalliert. Einige Installationen bleiben bestehen."
LangString MXB_PLUGIN_LANG ${LANG_GERMAN} "de"
