; packaging/lang/Italian.nsh - see English.nsh for what these are and the rules.

LangString MXB_WELCOME ${LANG_ITALIAN} "Questa procedura installerà ${PLUGIN_NAME} per i giochi di corse PiBoSo.$\n$\n${PLUGIN_NAME} è gratuito e open source.$\n$\nGiochi supportati:$\n  • MX Bikes$\n  • GP Bikes$\n  • Kart Racing Pro$\n$\nL'installazione proverà a trovare i tuoi giochi in automatico.$\n$\nScegli Avanti per continuare."
LangString MXB_FINISH ${LANG_ITALIAN} "${PLUGIN_NAME} è stato installato sul computer.$\n$\nImpostazioni e dati sono salvati per gioco in:$\n  Documents\PiBoSo\[Gioco]\${PLUGIN_NAME_LC}\$\n$\nScegli Chiudi per uscire dall'installazione."
LangString MXB_UN_FINISH ${LANG_ITALIAN} "${PLUGIN_NAME} è stato disinstallato dal computer.$\n$\nPer rimuovere impostazioni e dati, elimina a mano:$\n  Documents\PiBoSo\[Gioco]\${PLUGIN_NAME_LC}\$\n$\nScegli Chiudi per uscire."
LangString MXB_UN_FINISH_WIPED ${LANG_ITALIAN} "${PLUGIN_NAME} è stato disinstallato dal computer.$\n$\nSono stati rimossi anche impostazioni e dati dei giochi disinstallati.$\n$\nScegli Chiudi per uscire."
LangString MXB_EXIST_TITLE ${LANG_ITALIAN} "Trovata un'installazione di ${PLUGIN_NAME}"
LangString MXB_EXIST_SUB ${LANG_ITALIAN} "È stata trovata una versione esistente. Scegli come procedere."
LangString MXB_EXIST_FOUND ${LANG_ITALIAN} "Installazione di ${PLUGIN_NAME} trovata per: $R1"
LangString MXB_EXIST_CHOOSE ${LANG_ITALIAN} "Scegli un'azione."
LangString MXB_EXIST_ACTION ${LANG_ITALIAN} "Azione"
LangString MXB_EXIST_UPGRADE ${LANG_ITALIAN} "Aggiorna — sovrascrivi i file, mantieni impostazioni e dati"
LangString MXB_EXIST_FRESH ${LANG_ITALIAN} "Reinstalla da zero — sovrascrivi i file, azzera impostazioni e dati"
LangString MXB_EXIST_REMOVE ${LANG_ITALIAN} "Rimuovi (disinstalla) ${PLUGIN_NAME}"
LangString MXB_NOTE_KEEP ${LANG_ITALIAN} "Impostazioni e dati (Documents\PiBoSo\[Gioco]\${PLUGIN_NAME_LC}) verranno mantenuti."
LangString MXB_NOTE_WIPE ${LANG_ITALIAN} "Attenzione: impostazioni e dati esistenti (Documents\PiBoSo\[Gioco]\${PLUGIN_NAME_LC}) verranno eliminati per ogni gioco scelto."
LangString MXB_NOTE_UNINSTALL ${LANG_ITALIAN} "La disinstallazione ti farà scegliere se rimuovere anche impostazioni e dati."
LangString MXB_UNKNOWN ${LANG_ITALIAN} "Sconosciuto"
LangString MXB_PRIV_TITLE ${LANG_ITALIAN} "Privacy"
LangString MXB_PRIV_SUB ${LANG_ITALIAN} "Scegli se partecipare al sondaggio d'uso anonimo."
LangString MXB_PRIV_BODY ${LANG_ITALIAN} "${PLUGIN_NAME} può inviare un piccolo ping anonimo a ogni avvio, così lo sviluppatore vede quanti lo usano, quali funzioni tenere e cosa sistemare.$\n$\nInvia un ID di installazione casuale, versione e gioco, funzioni attive, obiettivi sbloccati, sistema operativo e lingua, durata della sessione e, in caso di crash, dove si è bloccato il gioco."
LangString MXB_PRIV_NEVER ${LANG_ITALIAN} "Mai inviati: il tuo nome, i tempi sul giro, l'attività online, dati di server o piloti, dump di crash. I tuoi contenuti non sono mai nominati: al più contano come $\"propri$\"."
LangString MXB_PRIV_CHECK ${LANG_ITALIAN} "Partecipa al sondaggio d'uso anonimo"
LangString MXB_PRIV_FOOT ${LANG_ITALIAN} "Disattivarlo non disattiva nient'altro; il plugin funziona allo stesso modo. Puoi cambiarlo quando vuoi in Impostazioni > Generale > Integrazioni."
LangString MXB_PRIV_POLICY ${LANG_ITALIAN} "Privacy"
LangString MXB_PRIV_REPORT ${LANG_ITALIAN} "Guarda il report d'uso pubblicato"
LangString MXB_GAMES_TITLE ${LANG_ITALIAN} "Scegli i giochi"
LangString MXB_GAMES_SUB ${LANG_ITALIAN} "Scegli per quali giochi installare ${PLUGIN_NAME}."
LangString MXB_DETECTED ${LANG_ITALIAN} "(rilevato)"
LangString MXB_NOT_DETECTED ${LANG_ITALIAN} "(non rilevato)"
LangString MXB_SELECT_ONE ${LANG_ITALIAN} "Scegli almeno un gioco da installare."
LangString MXB_SELECT_FOLDER ${LANG_ITALIAN} "Scegli la cartella di installazione di $gameLabel"
LangString MXB_SPECIFY_FOLDER ${LANG_ITALIAN} "Indica la cartella plugins di $gameLabel."
LangString MXB_NOT_PLUGINS_FOLDER ${LANG_ITALIAN} "Non sembra la cartella plugins di $gameLabel. Continuare comunque?"
LangString MXB_FRESH_CONFIRM ${LANG_ITALIAN} "La reinstallazione da zero eliminerà per sempre impostazioni e dati di ${PLUGIN_NAME} (profili, statistiche, benchmark, log, dump di crash) dei giochi scelti prima di reinstallare.$\n$\nNon si può annullare. Continuare?"
LangString MXB_ADMIN_INSTALL ${LANG_ITALIAN} "Servono i diritti di amministratore per installare nella cartella scelta.$\n$\nScegli una cartella in cui puoi scrivere, oppure chiudi e riavvia l'installazione come amministratore."
LangString MXB_DP_INSTALLING ${LANG_ITALIAN} "Installazione di ${PLUGIN_NAME} per $gameLabel..."
LangString MXB_DP_GAME_DONE ${LANG_ITALIAN} "Installazione per $gameLabel completata."
LangString MXB_DP_FRESH ${LANG_ITALIAN} "Reinstallazione da zero - eliminazione di impostazioni e dati esistenti..."
LangString MXB_DP_REMOVING_DATA ${LANG_ITALIAN} "Rimozione di impostazioni e dati:"
LangString MXB_DP_INSTALL_DONE ${LANG_ITALIAN} "Installazione completata."
LangString MXB_UN_TITLE ${LANG_ITALIAN} "Scegli cosa rimuovere"
LangString MXB_UN_SUB ${LANG_ITALIAN} "Scegli quali installazioni dei giochi rimuovere."
LangString MXB_CHANGE_SUB ${LANG_ITALIAN} "Deselezionare un gioco ne rimuove il plugin."
LangString MXB_CHANGE_SELECT_ONE ${LANG_ITALIAN} "Per rimuovere ${PLUGIN_NAME} da tutti i giochi, scegli Rimuovi nella pagina precedente."
LangString MXB_UN_DATA_CHECK ${LANG_ITALIAN} "Elimina anche impostazioni e dati (Documents\PiBoSo\[Gioco]\${PLUGIN_NAME_LC})"
LangString MXB_UN_SELECT_ONE ${LANG_ITALIAN} "Scegli almeno un gioco da disinstallare."
LangString MXB_UN_SELECT_ONE_MSG ${LANG_ITALIAN} "Scegli almeno un gioco da cui disinstallare."
LangString MXB_UN_DATA_CONFIRM ${LANG_ITALIAN} "Verranno eliminati per sempre impostazioni e dati di ${PLUGIN_NAME} (profili, statistiche, benchmark, log, dump di crash) dei giochi scelti.$\n$\nNon si può annullare. Continuare?"
LangString MXB_UN_ADMIN ${LANG_ITALIAN} "Servono i diritti di amministratore per rimuovere ${PLUGIN_NAME} dalla cartella scelta.$\n$\nChiudi e riavvia la disinstallazione come amministratore, oppure annulla."
LangString MXB_DP_UN_FILES ${LANG_ITALIAN} "Rimozione dei file di ${PLUGIN_NAME}..."
LangString MXB_DP_UN_FROM ${LANG_ITALIAN} "Rimozione da $gameLabel..."
LangString MXB_DP_UN_DATA ${LANG_ITALIAN} "Rimozione di impostazioni e dati di ${PLUGIN_NAME}..."
LangString MXB_DP_UN_DONE ${LANG_ITALIAN} "Disinstallazione completata."
LangString MXB_DP_ALL_REMOVED ${LANG_ITALIAN} "Tutte le installazioni sono state rimosse."
LangString MXB_DP_PARTIAL ${LANG_ITALIAN} "Disinstallazione parziale completata. Restano alcune installazioni."
LangString MXB_PLUGIN_LANG ${LANG_ITALIAN} "it"
