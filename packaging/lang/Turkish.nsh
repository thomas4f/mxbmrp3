; packaging/lang/Turkish.nsh - see English.nsh for what these are and the rules.

LangString MXB_WELCOME ${LANG_TURKISH} "Bu sihirbaz ${PLUGIN_NAME} eklentisini PiBoSo yarış oyunları için kuracak.$\n$\n${PLUGIN_NAME} ücretsiz ve açık kaynaklıdır.$\n$\nDesteklenen oyunlar:$\n  • MX Bikes$\n  • GP Bikes$\n  • Kart Racing Pro$\n$\nKurulum, oyunlarınızı otomatik olarak bulmaya çalışacak.$\n$\nDevam etmek için İleri'ye tıklayın."
LangString MXB_FINISH ${LANG_TURKISH} "${PLUGIN_NAME} bilgisayarınıza kuruldu.$\n$\nAyarlarınız ve verileriniz oyun başına burada tutulur:$\n  Documents\PiBoSo\[Oyun]\${PLUGIN_NAME_LC}\$\n$\nKurulumu kapatmak için Bitir'e tıklayın."
LangString MXB_UN_FINISH ${LANG_TURKISH} "${PLUGIN_NAME} bilgisayarınızdan kaldırıldı.$\n$\nTüm ayarları ve verileri kaldırmak için elle silin:$\n  Documents\PiBoSo\[Oyun]\${PLUGIN_NAME_LC}\$\n$\nKapatmak için Bitir'e tıklayın."
LangString MXB_UN_FINISH_WIPED ${LANG_TURKISH} "${PLUGIN_NAME} bilgisayarınızdan kaldırıldı.$\n$\nKaldırdığınız oyunların ayarları ve verileri de silindi.$\n$\nKapatmak için Bitir'e tıklayın."
LangString MXB_EXIST_TITLE ${LANG_TURKISH} "Mevcut ${PLUGIN_NAME} kurulumu bulundu"
LangString MXB_EXIST_SUB ${LANG_TURKISH} "Mevcut bir sürüm bulundu. Nasıl devam edeceğinizi seçin."
LangString MXB_EXIST_FOUND ${LANG_TURKISH} "Mevcut ${PLUGIN_NAME} kurulumu bulunan oyunlar: $R1"
LangString MXB_EXIST_CHOOSE ${LANG_TURKISH} "Bir işlem seçin."
LangString MXB_EXIST_ACTION ${LANG_TURKISH} "İşlem"
LangString MXB_EXIST_UPGRADE ${LANG_TURKISH} "Güncelle — dosyaların üzerine yaz, ayarları ve verileri koru"
LangString MXB_EXIST_FRESH ${LANG_TURKISH} "Temiz kurulum — dosyaların üzerine yaz, ayarları ve verileri sıfırla"
LangString MXB_EXIST_REMOVE ${LANG_TURKISH} "${PLUGIN_NAME} eklentisini kaldır"
LangString MXB_NOTE_KEEP ${LANG_TURKISH} "Ayarlarınız ve verileriniz (Documents\PiBoSo\[Oyun]\${PLUGIN_NAME_LC}) korunacak."
LangString MXB_NOTE_WIPE ${LANG_TURKISH} "Uyarı: mevcut ayarlar ve veriler (Documents\PiBoSo\[Oyun]\${PLUGIN_NAME_LC}) seçilen her oyun için silinecek."
LangString MXB_NOTE_UNINSTALL ${LANG_TURKISH} "Kaldırma programı, ayarları ve verileri de kaldırıp kaldırmamayı size soracak."
LangString MXB_UNKNOWN ${LANG_TURKISH} "Bilinmiyor"
LangString MXB_PRIV_TITLE ${LANG_TURKISH} "Gizlilik"
LangString MXB_PRIV_SUB ${LANG_TURKISH} "Anonim kullanım anketine katılıp katılmayacağınızı seçin."
LangString MXB_PRIV_BODY ${LANG_TURKISH} "${PLUGIN_NAME} her açılışta küçük bir anonim ping gönderebilir; geliştirici böylece kaç kişinin kullandığını, neyin değerli olduğunu ve neyin düzeltilmesi gerektiğini görür.$\n$\nGönderilenler: rastgele bir kurulum kimliği, eklenti sürümü ve oyun, açık özellikler, açılan başarımlar, işletim sistemi ve dil, oturum süresi ve oyun çöktüyse hatanın yeri."
LangString MXB_PRIV_NEVER ${LANG_TURKISH} "Asla gönderilmez: adınız, tur süreleri, çevrimiçi etkinlik, sunucu veya sürücü verileri, çökme dökümleri. Kendi içeriğiniz asla adıyla bildirilmez, en fazla $\"özel$\" sayılır."
LangString MXB_PRIV_CHECK ${LANG_TURKISH} "Anonim kullanım anketine katıl"
LangString MXB_PRIV_FOOT ${LANG_TURKISH} "Bunu kapatmak başka hiçbir şeyi kapatmaz; eklenti aynen çalışır. İstediğiniz zaman Ayarlar > Genel > Entegrasyonlar'dan değiştirebilirsiniz."
LangString MXB_PRIV_POLICY ${LANG_TURKISH} "Gizlilik politikası"
LangString MXB_PRIV_REPORT ${LANG_TURKISH} "Yayınlanan kullanım raporunu gör"
LangString MXB_GAMES_TITLE ${LANG_TURKISH} "Oyunları seçin"
LangString MXB_GAMES_SUB ${LANG_TURKISH} "${PLUGIN_NAME} eklentisinin kurulacağı oyunları seçin."
