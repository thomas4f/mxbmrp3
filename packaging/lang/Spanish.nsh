; packaging/lang/Spanish.nsh - see English.nsh for what these are and the rules.

LangString MXB_WELCOME ${LANG_SPANISH} "Este asistente instalará ${PLUGIN_NAME} para los juegos de carreras de PiBoSo.$\n$\n${PLUGIN_NAME} es gratuito y de código abierto.$\n$\nJuegos compatibles:$\n  • MX Bikes$\n  • GP Bikes$\n  • Kart Racing Pro$\n$\nEl instalador intentará encontrar tus juegos automáticamente.$\n$\nPulsa Siguiente para continuar."
LangString MXB_FINISH ${LANG_SPANISH} "${PLUGIN_NAME} se ha instalado en tu equipo.$\n$\nTus ajustes y datos se guardan por juego en:$\n  Documents\PiBoSo\[Juego]\${PLUGIN_NAME_LC}\$\n$\nPulsa Terminar para cerrar el instalador."
LangString MXB_UN_FINISH ${LANG_SPANISH} "${PLUGIN_NAME} se ha desinstalado de tu equipo.$\n$\nPara quitar todos los ajustes y datos, borra a mano:$\n  Documents\PiBoSo\[Juego]\${PLUGIN_NAME_LC}\$\n$\nPulsa Terminar para cerrar el instalador."
LangString MXB_UN_FINISH_WIPED ${LANG_SPANISH} "${PLUGIN_NAME} se ha desinstalado de tu equipo.$\n$\nTambién se han borrado los ajustes y datos de los juegos desinstalados.$\n$\nPulsa Terminar para cerrar el instalador."
LangString MXB_EXIST_TITLE ${LANG_SPANISH} "Se ha encontrado una instalación de ${PLUGIN_NAME}"
LangString MXB_EXIST_SUB ${LANG_SPANISH} "Se ha encontrado una versión existente. Elige cómo continuar."
LangString MXB_EXIST_FOUND ${LANG_SPANISH} "Instalación de ${PLUGIN_NAME} encontrada para: $R1"
LangString MXB_EXIST_CHOOSE ${LANG_SPANISH} "Elige una acción."
LangString MXB_EXIST_ACTION ${LANG_SPANISH} "Acción"
LangString MXB_EXIST_UPGRADE ${LANG_SPANISH} "Actualizar — sobrescribir archivos, conservar ajustes y datos"
LangString MXB_EXIST_FRESH ${LANG_SPANISH} "Instalación limpia — sobrescribir archivos y borrar ajustes y datos"
LangString MXB_EXIST_REMOVE ${LANG_SPANISH} "Quitar (desinstalar) ${PLUGIN_NAME}"
LangString MXB_NOTE_KEEP ${LANG_SPANISH} "Tus ajustes y datos (Documents\PiBoSo\[Juego]\${PLUGIN_NAME_LC}) se conservarán."
LangString MXB_NOTE_WIPE ${LANG_SPANISH} "Atención: los ajustes y datos existentes (Documents\PiBoSo\[Juego]\${PLUGIN_NAME_LC}) se borrarán para cada juego elegido."
LangString MXB_NOTE_UNINSTALL ${LANG_SPANISH} "El desinstalador te dejará elegir si también quieres quitar los ajustes y datos."
LangString MXB_UNKNOWN ${LANG_SPANISH} "Desconocido"
LangString MXB_PRIV_TITLE ${LANG_SPANISH} "Privacidad"
LangString MXB_PRIV_SUB ${LANG_SPANISH} "Elige si quieres participar en la encuesta de uso anónima."
LangString MXB_PRIV_BODY ${LANG_SPANISH} "${PLUGIN_NAME} puede enviar un pequeño ping anónimo al iniciar el juego, para que el desarrollador vea cuántos lo usan, qué funciones mantener y qué arreglar.$\n$\nEnvía un ID de instalación aleatorio, la versión y el juego, las funciones activas, los logros desbloqueados, sistema operativo e idioma, duración de la sesión y dónde falló el juego si se cerró."
LangString MXB_PRIV_NEVER ${LANG_SPANISH} "Nunca envía tu nombre, tiempos, actividad online, datos de servidor o pilotos ni volcados de errores. Tu contenido nunca se nombra; como mucho cuenta como $\"propio$\"."
LangString MXB_PRIV_CHECK ${LANG_SPANISH} "Participar en la encuesta de uso anónima"
LangString MXB_PRIV_FOOT ${LANG_SPANISH} "Desactivarla no desactiva nada más; el plugin funciona igual. Puedes cambiarlo cuando quieras en Ajustes > General > Integraciones."
LangString MXB_PRIV_POLICY ${LANG_SPANISH} "Privacidad"
LangString MXB_PRIV_REPORT ${LANG_SPANISH} "Ver el informe de uso publicado"
LangString MXB_GAMES_TITLE ${LANG_SPANISH} "Elegir juegos"
LangString MXB_GAMES_SUB ${LANG_SPANISH} "Elige para qué juegos instalar ${PLUGIN_NAME}."
LangString MXB_DETECTED ${LANG_SPANISH} "(detectado)"
LangString MXB_NOT_DETECTED ${LANG_SPANISH} "(no detectado)"
LangString MXB_SELECT_ONE ${LANG_SPANISH} "Elige al menos un juego para instalar."
LangString MXB_SELECT_FOLDER ${LANG_SPANISH} "Elige la carpeta de instalación de $gameLabel"
LangString MXB_SPECIFY_FOLDER ${LANG_SPANISH} "Indica la carpeta plugins de $gameLabel."
LangString MXB_NOT_PLUGINS_FOLDER ${LANG_SPANISH} "No parece ser la carpeta plugins de $gameLabel. ¿Continuar de todos modos?"
LangString MXB_FRESH_CONFIRM ${LANG_SPANISH} "La instalación limpia borrará para siempre todos los ajustes y datos de ${PLUGIN_NAME} (perfiles, estadísticas, benchmarks, registros, volcados de errores) de los juegos elegidos antes de reinstalar.$\n$\nNo se puede deshacer. ¿Continuar?"
LangString MXB_ADMIN_INSTALL ${LANG_SPANISH} "Se necesitan derechos de administrador para instalar en la carpeta elegida.$\n$\nElige una carpeta en la que puedas escribir, o cierra el instalador y vuelve a abrirlo como administrador."
LangString MXB_DP_INSTALLING ${LANG_SPANISH} "Instalando ${PLUGIN_NAME} para $gameLabel..."
LangString MXB_DP_GAME_DONE ${LANG_SPANISH} "Instalación para $gameLabel completada."
LangString MXB_DP_FRESH ${LANG_SPANISH} "Instalación limpia - borrando ajustes y datos existentes..."
LangString MXB_DP_REMOVING_DATA ${LANG_SPANISH} "Quitando ajustes y datos:"
LangString MXB_DP_INSTALL_DONE ${LANG_SPANISH} "Instalación completada."
LangString MXB_UN_TITLE ${LANG_SPANISH} "Elegir qué quitar"
LangString MXB_UN_SUB ${LANG_SPANISH} "Elige qué instalaciones de juegos quitar."
LangString MXB_CHANGE_SUB ${LANG_SPANISH} "Desmarcar un juego quita el plugin de ese juego."
LangString MXB_CHANGE_SELECT_ONE ${LANG_SPANISH} "Para quitar ${PLUGIN_NAME} de todos los juegos, elige Quitar en la página anterior."
LangString MXB_UN_DATA_CHECK ${LANG_SPANISH} "Borrar también ajustes y datos (Documents\PiBoSo\[Juego]\${PLUGIN_NAME_LC})"
LangString MXB_UN_SELECT_ONE ${LANG_SPANISH} "Elige al menos un juego para desinstalar."
LangString MXB_UN_SELECT_ONE_MSG ${LANG_SPANISH} "Elige al menos un juego del que desinstalar."
LangString MXB_UN_DATA_CONFIRM ${LANG_SPANISH} "Esto borrará para siempre todos los ajustes y datos de ${PLUGIN_NAME} (perfiles, estadísticas, benchmarks, registros, volcados de errores) de los juegos elegidos.$\n$\nNo se puede deshacer. ¿Continuar?"
LangString MXB_UN_ADMIN ${LANG_SPANISH} "Se necesitan derechos de administrador para quitar ${PLUGIN_NAME} de la carpeta elegida.$\n$\nCierra esto y vuelve a abrir el desinstalador como administrador, o cancela."
LangString MXB_DP_UN_FILES ${LANG_SPANISH} "Quitando archivos de ${PLUGIN_NAME}..."
LangString MXB_DP_UN_FROM ${LANG_SPANISH} "Quitando de $gameLabel..."
LangString MXB_DP_UN_DATA ${LANG_SPANISH} "Quitando ajustes y datos de ${PLUGIN_NAME}..."
LangString MXB_DP_UN_DONE ${LANG_SPANISH} "Desinstalación completada."
LangString MXB_DP_ALL_REMOVED ${LANG_SPANISH} "Se han quitado todas las instalaciones."
LangString MXB_DP_PARTIAL ${LANG_SPANISH} "Desinstalación parcial completada. Quedan algunas instalaciones."
LangString MXB_PLUGIN_LANG ${LANG_SPANISH} "es"
