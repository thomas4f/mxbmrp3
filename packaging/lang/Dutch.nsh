; packaging/lang/Dutch.nsh - see English.nsh for what these are and the rules.

LangString MXB_WELCOME ${LANG_DUTCH} "Deze wizard installeert ${PLUGIN_NAME} voor de racegames van PiBoSo.$\n$\n${PLUGIN_NAME} is gratis en open source.$\n$\nOndersteunde games:$\n  • MX Bikes$\n  • GP Bikes$\n  • Kart Racing Pro$\n$\nSetup probeert je game-installaties automatisch te vinden.$\n$\nKlik op Volgende om verder te gaan."
LangString MXB_FINISH ${LANG_DUTCH} "${PLUGIN_NAME} is op je computer geïnstalleerd.$\n$\nJe instellingen en gegevens staan per game in:$\n  Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC}\$\n$\nKlik op Voltooien om Setup te sluiten."
LangString MXB_UN_FINISH ${LANG_DUTCH} "${PLUGIN_NAME} is van je computer verwijderd.$\n$\nVerwijder handmatig om alle instellingen en gegevens te wissen:$\n  Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC}\$\n$\nKlik op Voltooien om Setup te sluiten."
LangString MXB_UN_FINISH_WIPED ${LANG_DUTCH} "${PLUGIN_NAME} is van je computer verwijderd.$\n$\nDe instellingen en gegevens van de verwijderde games zijn ook gewist.$\n$\nKlik op Voltooien om Setup te sluiten."
LangString MXB_EXIST_TITLE ${LANG_DUTCH} "Bestaande ${PLUGIN_NAME}-installatie gevonden"
LangString MXB_EXIST_SUB ${LANG_DUTCH} "Er is een bestaande versie gevonden. Kies hoe je verder wilt."
LangString MXB_EXIST_FOUND ${LANG_DUTCH} "Bestaande ${PLUGIN_NAME}-installatie gevonden voor: $R1"
LangString MXB_EXIST_CHOOSE ${LANG_DUTCH} "Kies een actie."
LangString MXB_EXIST_ACTION ${LANG_DUTCH} "Actie"
LangString MXB_EXIST_UPGRADE ${LANG_DUTCH} "Bijwerken — bestanden overschrijven, instellingen en gegevens houden"
LangString MXB_EXIST_FRESH ${LANG_DUTCH} "Schone installatie — bestanden overschrijven, instellingen en gegevens wissen"
LangString MXB_EXIST_REMOVE ${LANG_DUTCH} "${PLUGIN_NAME} verwijderen (de-installeren)"
LangString MXB_NOTE_KEEP ${LANG_DUTCH} "Je instellingen en gegevens (Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC}) blijven bewaard."
LangString MXB_NOTE_WIPE ${LANG_DUTCH} "Let op: bestaande instellingen en gegevens (Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC}) worden voor elke gekozen game gewist."
LangString MXB_NOTE_UNINSTALL ${LANG_DUTCH} "Bij het verwijderen kun je kiezen of ook instellingen en gegevens worden gewist."
LangString MXB_UNKNOWN ${LANG_DUTCH} "Onbekend"
LangString MXB_PRIV_TITLE ${LANG_DUTCH} "Privacy"
LangString MXB_PRIV_SUB ${LANG_DUTCH} "Kies of je meedoet aan het anonieme gebruiksonderzoek."
LangString MXB_PRIV_BODY ${LANG_DUTCH} "${PLUGIN_NAME} kan bij elke gamestart een kleine anonieme ping sturen, zodat de ontwikkelaar ziet hoeveel mensen het gebruiken, wat het houden waard is en wat stuk is.$\n$\nHet stuurt een willekeurige installatie-ID, de pluginversie en game, je actieve functies, ontgrendelde prestaties, besturingssysteem en taal, sessieduur en waar de game crashte."
LangString MXB_PRIV_NEVER ${LANG_DUTCH} "Nooit verstuurd: je naam, rondetijden, online activiteit, server- of rijdergegevens, crashdumps. Eigen inhoud wordt nooit bij naam gemeld, hooguit als $\"eigen$\"."
LangString MXB_PRIV_CHECK ${LANG_DUTCH} "Meedoen aan het anonieme gebruiksonderzoek"
LangString MXB_PRIV_FOOT ${LANG_DUTCH} "Uitzetten schakelt verder niets uit; de plugin werkt precies hetzelfde. Altijd te wijzigen via Instellingen > Algemeen > Integraties."
LangString MXB_PRIV_POLICY ${LANG_DUTCH} "Privacybeleid"
LangString MXB_PRIV_REPORT ${LANG_DUTCH} "Bekijk het gepubliceerde gebruiksrapport"
LangString MXB_GAMES_TITLE ${LANG_DUTCH} "Games kiezen"
LangString MXB_GAMES_SUB ${LANG_DUTCH} "Kies voor welke games ${PLUGIN_NAME} wordt geïnstalleerd."
LangString MXB_DETECTED ${LANG_DUTCH} "(gevonden)"
LangString MXB_NOT_DETECTED ${LANG_DUTCH} "(niet gevonden)"
LangString MXB_SELECT_ONE ${LANG_DUTCH} "Kies minstens één game om te installeren."
LangString MXB_SELECT_FOLDER ${LANG_DUTCH} "Kies de installatiemap van $gameLabel"
LangString MXB_SPECIFY_FOLDER ${LANG_DUTCH} "Geef de plugins-map van $gameLabel op."
LangString MXB_NOT_PLUGINS_FOLDER ${LANG_DUTCH} "Dit lijkt niet de plugins-map van $gameLabel. Toch doorgaan?"
LangString MXB_FRESH_CONFIRM ${LANG_DUTCH} "Een schone installatie wist vóór het installeren definitief alle ${PLUGIN_NAME}-instellingen en -gegevens (profielen, statistieken, benchmarks, logs, crashdumps) van de gekozen games.$\n$\nDit kan niet ongedaan worden gemaakt. Doorgaan?"
LangString MXB_ADMIN_INSTALL ${LANG_DUTCH} "Er zijn beheerdersrechten nodig om in de gekozen map te installeren.$\n$\nKies een map waarin je kunt schrijven, of sluit Setup en start het opnieuw als beheerder."
LangString MXB_DP_INSTALLING ${LANG_DUTCH} "${PLUGIN_NAME} wordt geïnstalleerd voor $gameLabel..."
LangString MXB_DP_GAME_DONE ${LANG_DUTCH} "Installatie voor $gameLabel voltooid."
LangString MXB_DP_FRESH ${LANG_DUTCH} "Schone installatie gekozen - bestaande instellingen en gegevens worden gewist..."
LangString MXB_DP_REMOVING_DATA ${LANG_DUTCH} "Instellingen en gegevens worden verwijderd:"
LangString MXB_DP_INSTALL_DONE ${LANG_DUTCH} "Installatie voltooid."
LangString MXB_UN_TITLE ${LANG_DUTCH} "Kies wat je wilt verwijderen"
LangString MXB_UN_SUB ${LANG_DUTCH} "Kies welke game-installaties worden verwijderd."
LangString MXB_CHANGE_SUB ${LANG_DUTCH} "Een game uitvinken verwijdert de plugin eruit."
LangString MXB_CHANGE_SELECT_ONE ${LANG_DUTCH} "Om ${PLUGIN_NAME} uit alle games te verwijderen, kies Verwijderen op de vorige pagina."
LangString MXB_UN_DATA_CHECK ${LANG_DUTCH} "Ook instellingen en gegevens wissen (Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC})"
LangString MXB_UN_SELECT_ONE ${LANG_DUTCH} "Kies minstens één game om te verwijderen."
LangString MXB_UN_SELECT_ONE_MSG ${LANG_DUTCH} "Kies minstens één game om uit te verwijderen."
LangString MXB_UN_DATA_CONFIRM ${LANG_DUTCH} "Hiermee worden alle ${PLUGIN_NAME}-instellingen en -gegevens (profielen, statistieken, benchmarks, logs, crashdumps) van de gekozen games definitief gewist.$\n$\nDit kan niet ongedaan worden gemaakt. Doorgaan?"
LangString MXB_UN_ADMIN ${LANG_DUTCH} "Er zijn beheerdersrechten nodig om ${PLUGIN_NAME} uit de gekozen map te verwijderen.$\n$\nSluit dit en start het verwijderprogramma opnieuw als beheerder, of annuleer."
LangString MXB_DP_UN_FILES ${LANG_DUTCH} "${PLUGIN_NAME}-bestanden worden verwijderd..."
LangString MXB_DP_UN_FROM ${LANG_DUTCH} "Verwijderen uit $gameLabel..."
LangString MXB_DP_UN_DATA ${LANG_DUTCH} "${PLUGIN_NAME}-instellingen en -gegevens worden verwijderd..."
LangString MXB_DP_UN_DONE ${LANG_DUTCH} "Verwijderen voltooid."
LangString MXB_DP_ALL_REMOVED ${LANG_DUTCH} "Alle installaties verwijderd."
LangString MXB_DP_PARTIAL ${LANG_DUTCH} "Gedeeltelijk verwijderd. Sommige installaties blijven bestaan."
LangString MXB_PLUGIN_LANG ${LANG_DUTCH} "nl"
