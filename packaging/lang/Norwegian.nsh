; packaging/lang/Norwegian.nsh - see English.nsh for what these are and the rules.

LangString MXB_WELCOME ${LANG_NORWEGIAN} "Denne veiviseren installerer ${PLUGIN_NAME} for PiBoSo-racingspill.$\n$\n${PLUGIN_NAME} er gratis og åpen kildekode.$\n$\nStøttede spill:$\n  • MX Bikes$\n  • GP Bikes$\n  • Kart Racing Pro$\n$\nInstallasjonen prøver å finne spillene dine automatisk.$\n$\nTrykk Neste for å fortsette."
LangString MXB_FINISH ${LANG_NORWEGIAN} "${PLUGIN_NAME} er installert på datamaskinen.$\n$\nInnstillinger og data lagres per spill i:$\n  Documents\PiBoSo\[Spill]\${PLUGIN_NAME_LC}\$\n$\nTrykk Ferdig for å lukke installasjonen."
LangString MXB_UN_FINISH ${LANG_NORWEGIAN} "${PLUGIN_NAME} er avinstallert fra datamaskinen.$\n$\nFor å fjerne alle innstillinger og data, slett for hånd:$\n  Documents\PiBoSo\[Spill]\${PLUGIN_NAME_LC}\$\n$\nTrykk Ferdig for å lukke."
LangString MXB_UN_FINISH_WIPED ${LANG_NORWEGIAN} "${PLUGIN_NAME} er avinstallert fra datamaskinen.$\n$\nInnstillinger og data for spillene du avinstallerte er også fjernet.$\n$\nTrykk Ferdig for å lukke."
LangString MXB_EXIST_TITLE ${LANG_NORWEGIAN} "Eksisterende ${PLUGIN_NAME}-installasjon funnet"
LangString MXB_EXIST_SUB ${LANG_NORWEGIAN} "En eksisterende versjon ble funnet. Velg hvordan du vil fortsette."
LangString MXB_EXIST_FOUND ${LANG_NORWEGIAN} "Eksisterende ${PLUGIN_NAME}-installasjon funnet for: $R1"
LangString MXB_EXIST_CHOOSE ${LANG_NORWEGIAN} "Velg en handling."
LangString MXB_EXIST_ACTION ${LANG_NORWEGIAN} "Handling"
LangString MXB_EXIST_UPGRADE ${LANG_NORWEGIAN} "Oppgrader — overskriv filene, behold innstillinger og data"
LangString MXB_EXIST_FRESH ${LANG_NORWEGIAN} "Ny installasjon — overskriv filene og nullstill innstillinger og data"
LangString MXB_EXIST_REMOVE ${LANG_NORWEGIAN} "Fjern (avinstaller) ${PLUGIN_NAME}"
LangString MXB_NOTE_KEEP ${LANG_NORWEGIAN} "Innstillingene og dataene dine (Documents\PiBoSo\[Spill]\${PLUGIN_NAME_LC}) blir beholdt."
LangString MXB_NOTE_WIPE ${LANG_NORWEGIAN} "Advarsel: eksisterende innstillinger og data (Documents\PiBoSo\[Spill]\${PLUGIN_NAME_LC}) slettes for hvert valgte spill."
LangString MXB_NOTE_UNINSTALL ${LANG_NORWEGIAN} "Avinstalleringen lar deg velge om innstillinger og data også skal fjernes."
LangString MXB_UNKNOWN ${LANG_NORWEGIAN} "Ukjent"
LangString MXB_PRIV_TITLE ${LANG_NORWEGIAN} "Personvern"
LangString MXB_PRIV_SUB ${LANG_NORWEGIAN} "Velg om du vil delta i den anonyme bruksundersøkelsen."
LangString MXB_PRIV_BODY ${LANG_NORWEGIAN} "${PLUGIN_NAME} kan sende et lite anonymt ping ved hver spillstart, så utvikleren ser hvor mange som bruker det, hva som er verdt å beholde og hva som må fikses.$\n$\nDet sender en tilfeldig installasjons-ID, plugin-versjon og spill, aktive funksjoner, opplåste prestasjoner, operativsystem og språk, øktlengde og hvor spillet feilet hvis det krasjet."
LangString MXB_PRIV_NEVER ${LANG_NORWEGIAN} "Sendes aldri: navnet ditt, rundetider, nettaktivitet, server- eller førerdata, krasjdumper. Eget innhold rapporteres aldri med navn, høyst som $\"egendefinert$\"."
LangString MXB_PRIV_CHECK ${LANG_NORWEGIAN} "Delta i den anonyme bruksundersøkelsen"
LangString MXB_PRIV_FOOT ${LANG_NORWEGIAN} "Å slå det av slår ikke av noe annet; pluginen virker helt likt. Du kan endre det når som helst i Innstillinger > Generelt > Integrasjoner."
LangString MXB_PRIV_POLICY ${LANG_NORWEGIAN} "Personvern"
LangString MXB_PRIV_REPORT ${LANG_NORWEGIAN} "Se den publiserte bruksrapporten"
LangString MXB_GAMES_TITLE ${LANG_NORWEGIAN} "Velg spill"
LangString MXB_GAMES_SUB ${LANG_NORWEGIAN} "Velg hvilke spill ${PLUGIN_NAME} skal installeres for."
LangString MXB_DETECTED ${LANG_NORWEGIAN} "(funnet)"
LangString MXB_NOT_DETECTED ${LANG_NORWEGIAN} "(ikke funnet)"
LangString MXB_SELECT_ONE ${LANG_NORWEGIAN} "Velg minst ett spill å installere."
LangString MXB_SELECT_FOLDER ${LANG_NORWEGIAN} "Velg installasjonsmappen til $gameLabel"
LangString MXB_SPECIFY_FOLDER ${LANG_NORWEGIAN} "Oppgi plugins-mappen til $gameLabel."
LangString MXB_NOT_PLUGINS_FOLDER ${LANG_NORWEGIAN} "Dette ser ikke ut som plugins-mappen til $gameLabel. Fortsette likevel?"
LangString MXB_FRESH_CONFIRM ${LANG_NORWEGIAN} "Ny installasjon sletter for godt alle ${PLUGIN_NAME}-innstillinger og -data (profiler, statistikk, benchmarks, logger, krasjdumper) for de valgte spillene før reinstallering.$\n$\nDette kan ikke angres. Fortsette?"
LangString MXB_ADMIN_INSTALL ${LANG_NORWEGIAN} "Administratorrettigheter kreves for å installere i den valgte mappen.$\n$\nVelg en mappe du kan skrive til, eller lukk installasjonen og kjør den på nytt som administrator."
LangString MXB_DP_INSTALLING ${LANG_NORWEGIAN} "Installerer ${PLUGIN_NAME} for $gameLabel..."
LangString MXB_DP_GAME_DONE ${LANG_NORWEGIAN} "Installasjon for $gameLabel fullført."
LangString MXB_DP_FRESH ${LANG_NORWEGIAN} "Ny installasjon valgt - sletter eksisterende innstillinger og data..."
LangString MXB_DP_REMOVING_DATA ${LANG_NORWEGIAN} "Fjerner innstillinger og data:"
LangString MXB_DP_INSTALL_DONE ${LANG_NORWEGIAN} "Installasjonen er fullført."
LangString MXB_UN_TITLE ${LANG_NORWEGIAN} "Velg hva som skal fjernes"
LangString MXB_UN_SUB ${LANG_NORWEGIAN} "Velg hvilke spillinstallasjoner som skal fjernes."
LangString MXB_CHANGE_SUB ${LANG_NORWEGIAN} "Fjernes haken, fjernes utvidelsen fra spillet."
LangString MXB_CHANGE_SELECT_ONE ${LANG_NORWEGIAN} "For å fjerne ${PLUGIN_NAME} fra alle spill, velg Fjern på forrige side."
LangString MXB_UN_DATA_CHECK ${LANG_NORWEGIAN} "Slett også innstillinger og data (Documents\PiBoSo\[Spill]\${PLUGIN_NAME_LC})"
LangString MXB_UN_SELECT_ONE ${LANG_NORWEGIAN} "Velg minst ett spill å avinstallere."
LangString MXB_UN_SELECT_ONE_MSG ${LANG_NORWEGIAN} "Velg minst ett spill å avinstallere fra."
LangString MXB_UN_DATA_CONFIRM ${LANG_NORWEGIAN} "Dette sletter for godt alle ${PLUGIN_NAME}-innstillinger og -data (profiler, statistikk, benchmarks, logger, krasjdumper) for de valgte spillene.$\n$\nDette kan ikke angres. Fortsette?"
LangString MXB_UN_ADMIN ${LANG_NORWEGIAN} "Administratorrettigheter kreves for å fjerne ${PLUGIN_NAME} fra den valgte mappen.$\n$\nLukk dette og kjør avinstalleringen på nytt som administrator, eller avbryt."
LangString MXB_DP_UN_FILES ${LANG_NORWEGIAN} "Fjerner ${PLUGIN_NAME}-filer..."
LangString MXB_DP_UN_FROM ${LANG_NORWEGIAN} "Fjerner fra $gameLabel..."
LangString MXB_DP_UN_DATA ${LANG_NORWEGIAN} "Fjerner ${PLUGIN_NAME}-innstillinger og -data..."
