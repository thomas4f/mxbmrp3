; packaging/lang/Swedish.nsh - see English.nsh for what these are and the rules.

LangString MXB_WELCOME ${LANG_SWEDISH} "Den här guiden installerar ${PLUGIN_NAME} för PiBoSos racingspel.$\n$\n${PLUGIN_NAME} är gratis och öppen källkod.$\n$\nSpel som stöds:$\n  • MX Bikes$\n  • GP Bikes$\n  • Kart Racing Pro$\n$\nInstallationen försöker hitta dina spel automatiskt.$\n$\nKlicka på Nästa för att fortsätta."
LangString MXB_FINISH ${LANG_SWEDISH} "${PLUGIN_NAME} har installerats på din dator.$\n$\nDina inställningar och data sparas per spel i:$\n  Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC}\$\n$\nKlicka på Slutför för att stänga installationen."
LangString MXB_UN_FINISH ${LANG_SWEDISH} "${PLUGIN_NAME} har avinstallerats från din dator.$\n$\nTa bort följande för hand för att radera alla inställningar och data:$\n  Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC}\$\n$\nKlicka på Slutför för att stänga."
LangString MXB_UN_FINISH_WIPED ${LANG_SWEDISH} "${PLUGIN_NAME} har avinstallerats från din dator.$\n$\nInställningar och data för spelen du avinstallerade har också tagits bort.$\n$\nKlicka på Slutför för att stänga."
LangString MXB_EXIST_TITLE ${LANG_SWEDISH} "En installation av ${PLUGIN_NAME} hittades"
LangString MXB_EXIST_SUB ${LANG_SWEDISH} "En befintlig version hittades. Välj hur du vill fortsätta."
LangString MXB_EXIST_FOUND ${LANG_SWEDISH} "Befintlig installation av ${PLUGIN_NAME} hittades för: $R1"
LangString MXB_EXIST_CHOOSE ${LANG_SWEDISH} "Välj vad du vill göra."
LangString MXB_EXIST_ACTION ${LANG_SWEDISH} "Åtgärd"
LangString MXB_EXIST_UPGRADE ${LANG_SWEDISH} "Uppgradera — skriv över filerna, behåll inställningar och data"
LangString MXB_EXIST_FRESH ${LANG_SWEDISH} "Ny installation — skriv över filerna och nollställ inställningar och data"
LangString MXB_EXIST_REMOVE ${LANG_SWEDISH} "Ta bort (avinstallera) ${PLUGIN_NAME}"
LangString MXB_NOTE_KEEP ${LANG_SWEDISH} "Dina inställningar och data (Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC}) behålls."
LangString MXB_NOTE_WIPE ${LANG_SWEDISH} "Varning: befintliga inställningar och data (Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC}) raderas för varje valt spel."
LangString MXB_NOTE_UNINSTALL ${LANG_SWEDISH} "Avinstallationen låter dig välja om även inställningar och data ska tas bort."
LangString MXB_UNKNOWN ${LANG_SWEDISH} "Okänt"
LangString MXB_PRIV_TITLE ${LANG_SWEDISH} "Integritet"
LangString MXB_PRIV_SUB ${LANG_SWEDISH} "Välj om du vill delta i den anonyma användningsundersökningen."
LangString MXB_PRIV_BODY ${LANG_SWEDISH} "${PLUGIN_NAME} kan skicka ett litet anonymt ping vid varje spelstart, så utvecklaren ser hur många som använder det, vad som är värt att behålla och vad som måste fixas.$\n$\nDet skickar ett slumpat installations-ID, pluginversion och spel, aktiva funktioner, upplåsta prestationer, operativsystem och språk, sessionslängd och var spelet fallerade om det kraschade."
LangString MXB_PRIV_NEVER ${LANG_SWEDISH} "Skickas aldrig: ditt namn, varvtider, onlineaktivitet, server- eller förardata, kraschdumpar. Eget innehåll rapporteras aldrig med namn, högst som $\"eget$\"."
LangString MXB_PRIV_CHECK ${LANG_SWEDISH} "Delta i den anonyma användningsundersökningen"
LangString MXB_PRIV_FOOT ${LANG_SWEDISH} "Att stänga av det stänger inte av något annat; pluginen fungerar precis likadant. Ändra när som helst i Inställningar > Allmänt > Integrationer."
LangString MXB_PRIV_POLICY ${LANG_SWEDISH} "Integritetspolicy"
LangString MXB_PRIV_REPORT ${LANG_SWEDISH} "Se den publicerade användningsrapporten"
LangString MXB_GAMES_TITLE ${LANG_SWEDISH} "Välj spel"
LangString MXB_GAMES_SUB ${LANG_SWEDISH} "Välj vilka spel ${PLUGIN_NAME} ska installeras för."
LangString MXB_DETECTED ${LANG_SWEDISH} "(hittad)"
LangString MXB_NOT_DETECTED ${LANG_SWEDISH} "(hittades inte)"
LangString MXB_SELECT_ONE ${LANG_SWEDISH} "Välj minst ett spel att installera."
LangString MXB_SELECT_FOLDER ${LANG_SWEDISH} "Välj installationsmappen för $gameLabel"
LangString MXB_SPECIFY_FOLDER ${LANG_SWEDISH} "Ange plugins-mappen för $gameLabel."
LangString MXB_NOT_PLUGINS_FOLDER ${LANG_SWEDISH} "Det här verkar inte vara plugins-mappen för $gameLabel. Fortsätta ändå?"
LangString MXB_FRESH_CONFIRM ${LANG_SWEDISH} "En ny installation raderar för gott alla inställningar och data för ${PLUGIN_NAME} (profiler, statistik, benchmarks, loggar, kraschdumpar) för de valda spelen innan ominstallationen.$\n$\nDet går inte att ångra. Fortsätta?"
LangString MXB_ADMIN_INSTALL ${LANG_SWEDISH} "Administratörsbehörighet krävs för att installera i den valda mappen.$\n$\nVälj en mapp du kan skriva till, eller stäng installationen och kör den igen som administratör."
LangString MXB_DP_INSTALLING ${LANG_SWEDISH} "Installerar ${PLUGIN_NAME} för $gameLabel..."
LangString MXB_DP_GAME_DONE ${LANG_SWEDISH} "Installationen för $gameLabel är klar."
LangString MXB_DP_FRESH ${LANG_SWEDISH} "Ny installation vald - raderar befintliga inställningar och data..."
LangString MXB_DP_REMOVING_DATA ${LANG_SWEDISH} "Tar bort inställningar och data:"
LangString MXB_DP_INSTALL_DONE ${LANG_SWEDISH} "Installationen är klar."
LangString MXB_UN_TITLE ${LANG_SWEDISH} "Välj vad som ska tas bort"
LangString MXB_UN_SUB ${LANG_SWEDISH} "Välj vilka spelinstallationer som ska tas bort."
LangString MXB_CHANGE_SUB ${LANG_SWEDISH} "Avmarkerar du ett spel tas pluginet bort från det."
LangString MXB_CHANGE_SELECT_ONE ${LANG_SWEDISH} "Välj Ta bort på föregående sida för att ta bort ${PLUGIN_NAME} från alla spel."
LangString MXB_UN_DATA_CHECK ${LANG_SWEDISH} "Radera även inställningar och data (Documents\PiBoSo\[Spel]\${PLUGIN_NAME_LC})"
LangString MXB_UN_SELECT_ONE ${LANG_SWEDISH} "Välj minst ett spel att avinstallera."
LangString MXB_UN_SELECT_ONE_MSG ${LANG_SWEDISH} "Välj minst ett spel att avinstallera från."
LangString MXB_UN_DATA_CONFIRM ${LANG_SWEDISH} "Detta raderar för gott alla inställningar och data för ${PLUGIN_NAME} (profiler, statistik, benchmarks, loggar, kraschdumpar) för de valda spelen.$\n$\nDet går inte att ångra. Fortsätta?"
LangString MXB_UN_ADMIN ${LANG_SWEDISH} "Administratörsbehörighet krävs för att ta bort ${PLUGIN_NAME} från den valda mappen.$\n$\nStäng detta och kör avinstallationen igen som administratör, eller avbryt."
LangString MXB_DP_UN_FILES ${LANG_SWEDISH} "Tar bort filer för ${PLUGIN_NAME}..."
LangString MXB_DP_UN_FROM ${LANG_SWEDISH} "Tar bort från $gameLabel..."
LangString MXB_DP_UN_DATA ${LANG_SWEDISH} "Tar bort inställningar och data för ${PLUGIN_NAME}..."
LangString MXB_DP_UN_DONE ${LANG_SWEDISH} "Avinstallationen är klar."
LangString MXB_DP_ALL_REMOVED ${LANG_SWEDISH} "Alla installationer har tagits bort."
LangString MXB_DP_PARTIAL ${LANG_SWEDISH} "Delvis avinstallerat. Vissa installationer finns kvar."
