msgid "You"
msgstr "Tú"

msgid "You have the latest version."
msgstr "Tienes la versión más reciente."

#. max 25 characters
msgid "YouTube"
msgstr "YouTube"

msgid "YouTube chat can't be read. Support is unofficial."
msgstr "El chat de YouTube no se puede leer. El soporte no es oficial."

msgid "YouTube chat unavailable"
msgstr "Chat de YouTube no disponible"

msgid "YouTube connection lost - retrying automatically."
msgstr "Conexión con YouTube perdida - reintentando automáticamente."

msgid "YouTube has no such channel - check the spelling."
msgstr "YouTube no tiene ese canal - revisa cómo se escribe."

msgid "YouTube's chat can't be read"
msgstr "El chat de YouTube no se puede leer"

msgid "YouTube: not live right now - checking every minute."
msgstr "YouTube: no en directo ahora - comprobando cada minuto."

msgctxt "tooltip"
msgid "Your Twitch and YouTube chat in game, merged in one window. Read-only, no login."
msgstr "Tu chat de Twitch y YouTube en el juego, juntos en una ventana. Solo lectura, sin login."

msgid "Your final lap"
msgstr "Tu última vuelta"

msgctxt "tooltip"
msgid "Your gap to a reference lap across the whole lap: green where you gained, red where you lost."
msgstr "Tu dif. con una vuelta de referencia en toda la vuelta: verde donde ganaste, rojo donde perdiste."

msgctxt "tooltip"
msgid "Your last and best lap with their gap to your ideal lap, and the ideal itself."
msgstr "Tu última y mejor vuelta con su dif. con la vuelta ideal, y la ideal misma."

msgctxt "tooltip"
msgid "Your last three laps with their gap to your best, in the Lap Log's order."
msgstr "Tus tres últimas vueltas con su dif. con la mejor, en el orden del HUD Vueltas."

msgctxt "tooltip"
msgid "Your numbers: lap and sector times, position, gaps, time left."
msgstr "Tus números: tiempos de vuelta y sector, posición, difs., tiempo restante."

msgctxt "tooltip"
msgid "Your row and the riders around it, drawn as on Standings."
msgstr "Tu fila y los pilotos de alrededor, dibujados como en Clasificación."

msgctxt "tooltip"
msgid "Your running lap time, with your gap to your reference lap under it."
msgstr "Tu tiempo de vuelta en curso, con la dif. con la vuelta de referencia debajo."

#. max 23 characters
msgid "Zoom"
msgstr "Zoom"

msgctxt "tooltip"
msgid "Zoom: how many meters of track Follow shows around you."
msgstr "Zoom: cuántos metros de pista muestra Seguir a tu alrededor."

#. max 60 characters
