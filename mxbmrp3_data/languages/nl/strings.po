# Nederlands (Dutch) language pack for MXBMRP3 - BETA.
# Drafted for 1.35; not yet reviewed line by line by a native speaker.
# Corrections are welcome: see README.md in the parent folder.
#
# Glossary (keep these consistent):
#   rider = rijder, bike = motor, lap = ronde, sector = sector,
#   split = split / tussentijd, gap = gat, PB = PR (persoonlijk record),
#   standings = stand, pits = pits, penalty = straf, session = sessie,
#   practice = training, qualify = kwalificatie, race = race,
#   settings = instellingen, hotkeys = sneltoetsen, rumble = trilling,
#   notice = melding, toast = pop-up, callout = omroep,
#   achievement = prestatie, profile = profiel, crash = crash,
#   controller = controller, race number = startnummer,
#   auto-director = auto-regie, web overlay = web-overlay, On/Off = Aan/Uit,
#   Default = Standaard. Ordinals: 1E, 2E (FINISHED %d%s).
#   Kept in English as players say them: HUD, Dash, Companion, Gap Bar,
#   Delta Trace, holeshot, whip, scrub, oppo, endo, stoppie, backflip,
#   frontflip, turn down, trick, FMX, OBS, live, replay, spotter, widget,
#   RPM, Rev, Speedo, Performance.
