#. max 25 characters
msgid "YouTube"
msgstr "YouTube"

msgid "YouTube chat can't be read. Support is unofficial."
msgstr "YouTube-chat kan ikke leses. Støtten er uoffisiell."

msgid "YouTube chat unavailable"
msgstr "YouTube-chat utilgjengelig"

msgid "YouTube connection lost - retrying automatically."
msgstr "YouTube-tilkobling brutt - prøver igjen automatisk."

msgid "YouTube has no such channel - check the spelling."
msgstr "YouTube har ingen slik kanal - sjekk stavemåten."

msgid "YouTube's chat can't be read"
msgstr "YouTubes chat kan ikke leses"

msgid "YouTube: not live right now - checking every minute."
msgstr "YouTube: ikke live nå - sjekker hvert minutt."

msgctxt "tooltip"
msgid "Your Twitch and YouTube chat in game, merged in one window. Read-only, no login."
msgstr "Twitch- og YouTube-chatten din i spillet, samlet i ett vindu. Kun lesing, ingen innlogging."

msgid "Your final lap"
msgstr "Din siste runde"

msgctxt "tooltip"
msgid "Your freestyle tricks, landings and crashes. Never in a race."
msgstr "Dine freestyle-triks, landinger og krasj. Aldri i løp."

msgctxt "tooltip"
msgid "Your gap to a reference lap across the whole lap: green where you gained, red where you lost."
msgstr "Avstanden til en referanserunde gjennom hele runden: grønn der du vant, rød der du tapte."

msgctxt "tooltip"
msgid "Your last and best lap with their gap to your ideal lap, and the ideal itself."
msgstr "Siste og beste runde med avstand til idealrunden, og idealrunden selv."

msgctxt "tooltip"
msgid "Your last three laps with their gap to your best, in the Lap Log's order."
msgstr "Dine tre siste runder med avstand til beste, i Rundeloggens rekkefølge."

msgctxt "tooltip"
msgid "Your numbers: lap and sector times, position, gaps, time left."
msgstr "Dine tall: runde- og sektortider, posisjon, avstander, tid igjen."

msgctxt "tooltip"
msgid "Your row and the riders around it, drawn as on Standings."
msgstr "Din rad og kjørerne rundt, tegnet som i Stilling."

msgctxt "tooltip"
msgid "Your running lap time, with your gap to your reference lap under it."
msgstr "Din løpende rundetid, med avstanden til referanserunden under."

