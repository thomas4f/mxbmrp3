msgstr "Breitenfaktor des Gap-Balkens."

#, c-format
msgid "Win %s races"
msgstr "Gewinne %s Rennen"

#, c-format
msgid "Win %s races leading every lap"
msgstr "Gewinne %s Rennen und führe jede Runde"

msgid "Win a race"
msgstr "Gewinne ein Rennen"

msgid "Win a race by under a tenth"
msgstr "Gewinne ein Rennen um weniger als eine Zehntelsekunde"

msgid "Win a race leading every lap"
msgstr "Gewinne ein Rennen und führe jede Runde"

msgid "Win with every rider at least a lap down"
msgstr "Gewinne mit mindestens einer Runde Vorsprung auf alle"

